<?xml version="1.0" encoding="UTF-8"?>
<!-- Apache 2.4 is the supported production server. Reject accidental IIS
     deployment: the former partial rules were not equivalent to .htaccess.
     Do not remove this guard to enable IIS; see DEPLOYMENT.md section 21. -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <verbs allowUnlisted="false" applyToWebDAV="true"><clear /></verbs>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
