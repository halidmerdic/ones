<?xml version="1.0" encoding="UTF-8"?>
<!-- Data must not be served, including when copied outside the application. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <verbs allowUnlisted="false" applyToWebDAV="true"><clear /></verbs>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
