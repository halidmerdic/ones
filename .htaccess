Options -Indexes
DirectoryIndex index.html
AcceptPathInfo Off

# Rewriting enforces the public-file allowlist; fail closed when unavailable.
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep one public homepage URL for SEO and a cleaner address bar.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?ones\.ba$ [NC]
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ https://ones.ba/ [R=301,L,NE,QSD]

  # Canonicalize the www subdomain to the secure apex domain.
  RewriteCond %{HTTP_HOST} ^www\.ones\.ba$ [NC]
  RewriteRule ^ https://ones.ba%{REQUEST_URI} [R=301,L,NE]

  # Full (strict) keeps the Cloudflare-to-origin connection on HTTPS too.
  RewriteCond %{HTTP_HOST} ^ones\.ba$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://ones.ba%{REQUEST_URI} [R=301,L,NE]

  # Do not expose repository metadata or other hidden files.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

  # No executable suffixes in public media, including PHP disguised as an image.
  RewriteRule ^(?:assets|uploads)/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|asp|aspx|jsp|exe|dll)(?:[./]|$) - [F,L,NC]

  # Only runtime entry points and public assets; all other paths are private.
  RewriteRule !^(?:$|(?:index|admin|blog|cart|login|privacy|product|profile|terms|verify)\.html|(?:admin|api-client|app|blog|cart|cms-focus|login|product|profile|profile-orders|storage|theme|verify)\.js|(?:styles|admin|cms-relations|admin-feedback|admin-responsive|verify)\.css|(?:api|sitemap)\.php|robots\.txt|(?:assets|uploads)/.+\.(?:webp|png|jpe?g|gif|svg|ico|avif|pdf|woff2?|ttf|otf|css|js)|\.well-known/acme-challenge/[A-Za-z0-9_-]+)$ - [F,L,NC]
</IfModule>

<FilesMatch "(?i)(^config(?:\..*)?\.php$|\.(?:sqlite|db)(?:[-.].*)?$|\.(?:conf|ini|env|log|json|sql|md|ya?ml|zip|7z|rar|tar|gz|bak|lock)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

<Files "admin.html">
  <IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
  </IfModule>
</Files>

<FilesMatch "^(api\.php|admin\.html|cart\.html|login\.html|profile\.html|verify\.html)$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate, private, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </IfModule>
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/webp "access plus 90 days"
  ExpiresByType image/png "access plus 90 days"
  ExpiresByType image/jpeg "access plus 90 days"
  ExpiresByType image/svg+xml "access plus 90 days"
  ExpiresByType application/pdf "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
